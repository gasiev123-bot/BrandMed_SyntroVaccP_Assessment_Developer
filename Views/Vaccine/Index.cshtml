@model IEnumerable<SyntroVaccPApp.DTOs.Vaccine.VaccineReadDto>

@{
    ViewData["Title"] = "Vaccine Management";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int pageSize = ViewBag.PageSize;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 style="color: #004d5d;"><i class="bi bi-shield-plus me-2" style="color: #00ced1;"></i>Vaccine Management</h2>
    @if (User.IsInRole("Admin"))
    {
        <button type="button" class="btn text-white shadow-sm" style="background-color: #004d5d;"
                onclick="openCreateVaccineModal()">
            <i class="bi bi-plus-lg"></i> Add New Vaccine
        </button>
    }
</div>
@* --- Brand-Themed Success Alert --- *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0"
         style="border-left: 5px solid #00ced1 !important; background-color: white;" role="alert">
        <i class="bi bi-check-circle-fill me-2" style="color: #00ced1;"></i>
        <strong style="color: #004d5d;">Success:</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@* Page Size Selector - Fixed Logic *@
<div class="d-flex justify-content-end mb-3">
    <div class="btn-group btn-group-sm shadow-sm" role="group">
        <span class="btn btn-light disabled border small">Show:</span>
        <a asp-action="Index" asp-route-pageSize="5" asp-route-page="1"
           class="btn @(pageSize == 5 ? "text-white" : "btn-outline-secondary")"
           style="@(pageSize == 5 ? "background-color: #004d5d;" : null)">5</a>
        <a asp-action="Index" asp-route-pageSize="20" asp-route-page="1"
           class="btn @(pageSize == 20 ? "text-white" : "btn-outline-secondary")"
           style="@(pageSize == 20 ? "background-color: #004d5d;" : null)">20</a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead style="background-color: #004d5d; color: white;">
                <tr>
                    <th class="ps-4">Vaccine Name</th>
                    <th>Manufacturer</th>
                    <th class="text-center">Doses Required</th>
                    <th class="text-center">Interval (Days)</th>
                    <th>Status</th>
                    <th class="text-center pe-4">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4"><strong>@item.Name</strong></td>
                            <td>@item.Manufacturer</td>
                            <td class="text-center">@item.DosesRequired</td>
                            <td class="text-center">@(item.DoseIntervalDays?.ToString() ?? "N/A")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge rounded-pill px-3" style="background-color: rgba(0, 206, 209, 0.1); color: #004d5d; border: 1px solid #00ced1;">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill px-3">Inactive</span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <div class="btn-group" role="group">
                                    @* MODAL TRIGGER *@
                                    <button type="button" class="btn btn-sm text-white"
                                            style="background-color: #00ced1; border-color: #00ced1;"
                                            onclick="openEditVaccineModal(@item.VaccineId)">
                                        <i class="bi bi-pencil-fill"></i> Edit
                                    </button>

                                    <form asp-action="Delete" asp-route-id="@item.VaccineId" method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this vaccine?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                                            <i class="bi bi-trash-fill"></i> Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No vaccines found in the catalogue.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Pagination - Centered with Theme Colors *@
@if (totalPages > 1)
{
    <nav aria-label="Vaccine page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link border-0 shadow-sm mx-1 rounded text-dark" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize">
                    <span aria-hidden="true">&laquo;</span> Previous
                </a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(currentPage == i ? "active" : "")">
                    <a class="page-link border-0 shadow-sm mx-1 rounded @(currentPage == i ? "text-white" : "text-dark")"
                       style="@(currentPage == i ? "background-color: #00ced1;" : null)"
                       asp-action="Index" asp-route-page="@i" asp-route-pageSize="@pageSize">@i</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link border-0 shadow-sm mx-1 rounded text-dark" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize">
                    Next <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
}
<!-- CREATE VACCINE MODAL -->
<div class="modal fade" id="createVaccineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header text-white" style="background-color: #004d5d;">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-plus-circle me-2" style="color: #00ced1;"></i>Register New Vaccine
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="createVaccineModalBody">
                @* Content loaded via AJAX *@
            </div>
        </div>
    </div>
</div>

@* --- EDIT VACCINE MODAL --- *@
<div class="modal fade" id="editVaccineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header text-white" style="background-color: #004d5d;">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-shield-plus me-2" style="color: #00ced1;"></i>Update Vaccine Definition
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="editVaccineModalBody">
                @* Content loaded via AJAX *@
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openCreateVaccineModal()
        {
            var createModal = new bootstrap.Modal(document.getElementById('createVaccineModal'));
            createModal.show();
            $('#createVaccineModalBody').html('<div class="text-center p-5"><div class="spinner-border" style="color: #00ced1;"></div></div>');

            $.get('/Vaccine/Create', function (data) {
                $('#createVaccineModalBody').html(data);
            });
        }

        function openEditVaccineModal(id)
        { 
            $('#editVaccineModalBody').html('<div class="text-center p-5"><div class="spinner-border" style="color: #00ced1;"></div><p class="mt-3 text-muted">Accessing Catalogue...</p></div>');

            var myModal = new bootstrap.Modal(document.getElementById('editVaccineModal'));
            myModal.show();
 
            $.get('/Vaccine/Edit/' + id, function (data) {
                $('#editVaccineModalBody').html(data);
            }).fail(function() {
                $('#editVaccineModalBody').html('<div class="alert alert-danger">Error: Could not retrieve vaccine data.</div>');
            });
        }

    </script>
    <partial name="_ValidationScriptsPartial" />
}
