@model IEnumerable<SyntroVaccPApp.Models.VaccineBatch>

@{
    ViewData["Title"] = "Vaccine Inventory Status";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int pageSize = ViewBag.PageSize ?? 5;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 d-print-none">
        <h2 class="fw-bold mb-0" style="color: #004d5d;">
            <i class="bi bi-box-seam-fill me-2" style="color: #00ced1;"></i>Inventory & Batch Status
        </h2>

        <a href="javascript:void(0);" class="btn btn-outline-secondary shadow-sm d-none d-md-block"
           onclick="window.open('@Url.Action("PrintBatchStockReport", "Reports")', '_blank')">
            <i class="bi bi-printer me-1"></i> Print to PDF
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-3"
             style="border-left: 5px solid #198754 !important;" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-3 fs-4"></i>
                <div>
                    <h6 class="mb-0 fw-bold">Success!</h6>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* --- Page Size Selector --- *@
    <div class="d-flex justify-content-end mb-2">
        <div class="btn-group btn-group-sm shadow-sm">
            <span class="btn btn-light disabled border small">Show:</span>
            @foreach (var size in new[] { 5, 10, 20 })
            {
                <a asp-action="BatchStock"
                   asp-route-page="1"
                   asp-route-pageSize="@size"
                   class="btn @(pageSize == size ? "text-white" : "btn-outline-secondary")"
                   style="@(pageSize == size ? "background-color:#004d5d;" : null)">
                    @size
                </a>
            }
        </div>
    </div>

    @* --- Vaccine Batch Table --- *@
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #004d5d; color: white;">
                    <tr>
                        <th class="ps-4 py-3">Batch Details</th>
                        <th>Vaccine</th>
                        <th>Expiry Date</th>
                        <th>Status</th> 
                        <th class="pe-4 text-end d-print-none">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var batch in Model)
                    {
                        var isExpired = batch.ExpiryDate < DateTime.Today;
                        var isExpiringSoon = !isExpired && batch.ExpiryDate <= DateTime.Today.AddDays(30);
                        <tr>
                            <td class="ps-4 fw-bold" style="color: #004d5d;">@batch.BatchNumber</td>
                            <td>@(batch.Vaccine?.Name ?? "General")</td>
                            <td class="@(isExpired ? "text-muted text-decoration-line-through" : (isExpiringSoon ? "fw-bold" : "text-dark"))"
                                style="@(isExpiringSoon ? "color: #00ced1;" : "")">
                                @batch.ExpiryDate.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                @if (isExpired)
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary">Expired</span>
                                }
                                else if (isExpiringSoon)
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info"
                                          style="color: #00ced1 !important; border-color: #00ced1 !important;">Expiring Soon</span>
                                }
                                else
                                {
                                    <span class="user-badge" style="background: rgba(0, 206, 209, 0.15); color: #004d5d; border: 1px solid #00ced1; padding: 4px 12px; border-radius: 20px; font-size: 0.8rem;">Active</span>
                                }
                            </td> 
                            <td class="pe-4 text-end d-print-none">
                                <button type="button" class="btn btn-sm text-white" style="background-color: #004d5d;"
                                        onclick="openEditBatchModal(@batch.BatchId)">
                                    Manage
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* --- Pagination Below Table --- *@
    @if (totalPages > 1)
    {
        <nav class="mt-3" aria-label="Batch pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link border-0 shadow-sm mx-1 rounded text-dark"
                       style="background-color: #f8f9fa;"
                       asp-action="BatchStock"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-pageSize="@pageSize">&laquo; Previous</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link border-0 shadow-sm mx-1 rounded @(currentPage == i ? "text-white" : "text-dark")"
                           style="@(currentPage == i ? "background-color:#00ced1;" : "background-color:#f8f9fa;")"
                           asp-action="BatchStock"
                           asp-route-page="@i"
                           asp-route-pageSize="@pageSize">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link border-0 shadow-sm mx-1 rounded text-dark"
                       style="background-color: #f8f9fa;"
                       asp-action="BatchStock"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-pageSize="@pageSize">Next &raquo;</a>
                </li>
            </ul>
        </nav>
    }
</div>

@* --- Edit Batch Modal --- *@
<div class="modal fade" id="editBatchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header text-white" style="background-color: #004d5d;">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-pencil-square me-2" style="color: #00ced1;"></i>Edit Batch
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="editBatchModalBody">
                <div class="text-center p-4">
                    <div class="spinner-border" style="color: #00ced1;" role="status"></div>
                    <p class="mt-2 text-muted">Loading Batch Details...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        body

    {
        background: white !important;
    }

    .btn,
    .pagination,
    .modal,
    .d-none,
    .btn-group,
    .card {
        display: none !important;
    }

    .table {
        font-size: 12px;
    }

    h2 {
        text-align: center;
        margin-bottom: 20px;
    }

    .container {
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    thead {
        background-color: #004d5d !important;
        color: white !important;
        -webkit-print-color-adjust: exact;
    }

    }
</style>

@section Scripts {
    <script>
        function downloadBatchReport() {
             const url = '@Url.Action("PrintBatchStockReport", "Reports")';
             const link = document.createElement('a');
             link.href = url;
             link.download = 'BatchStockReport.pdf';
             document.body.appendChild(link);
             link.click();
             document.body.removeChild(link);
         }
         function openEditBatchModal(id) {
             if (!id) return;
             var modalElement = document.getElementById('editBatchModal');
             var myModal = new bootstrap.Modal(modalElement);

             $('#editBatchModalBody').html('<div class="text-center p-4"><div class="spinner-border" style="color: #00ced1;"></div><p class="mt-2 text-muted">Fetching record...</p></div>');

             myModal.show();

             $('#editBatchModalBody').load('@Url.Action("Edit", "VaccineBatch")/' + id, function (response, status, xhr) {
                 if (status == "error") {
                     $('#editBatchModalBody').html('<div class="alert alert-danger">Error loading record. Please try again.</div>');
                 }
             });
         }
    </script>
}
