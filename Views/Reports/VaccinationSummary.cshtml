@model IEnumerable<SyntroVaccPApp.DTOs.Reports.VaccinationReportDto>

@{
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int pageSize = ViewBag.PageSize ?? 5;
}

<div class="container mt-4">
    <h2 class="mb-4 fw-bold" style="color: #004d5d;">
        <i class="bi bi-clipboard2-pulse me-2" style="color: #00ced1;"></i>Vaccination Summary Report
    </h2>

    <form method="get" class="row g-3 mb-4 bg-white p-3 border rounded shadow-sm">
        <div class="col-md-4">
            <label class="form-label fw-bold">From</label>
            <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control border-secondary" />
        </div>
        <div class="col-md-4">
            <label class="form-label fw-bold">To</label>
            <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control border-secondary" />
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn text-white w-100" style="background-color: #004d5d;">
                <i class="bi bi-funnel-fill me-1"></i> Filter Records
            </button>
        </div>
    </form>

    @* --- Page Size Selector --- *@
    <div class="d-flex justify-content-end mb-2">
        <div class="btn-group btn-group-sm shadow-sm">
            <span class="btn btn-light disabled border small">Show:</span>

            @foreach (var size in new[] { 5, 10, 20 })
            {
                <a asp-action="VaccinationSummary"
                   asp-route-startDate="@ViewBag.StartDate"
                   asp-route-endDate="@ViewBag.EndDate"
                   asp-route-page="1"
                   asp-route-pageSize="@size"
                   class="btn @(pageSize == size ? "text-white" : "btn-outline-secondary")"
                   style="@(pageSize == size ? "background-color:#004d5d;" : null)">
                    @size
                </a>
            }
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover border align-middle shadow-sm" style="min-width: 600px;">
            <thead style="background-color: #004d5d; color: white;" class="text-nowrap">
                <tr>
                    <th>Vaccine Name</th>
                    <th>Facility</th>
                    <th class="text-center">Total Doses Administered</th>
                </tr>
            </thead>
            <tbody class="bg-white">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-nowrap fw-bold" style="color: #004d5d;">@item.VaccineName</td>
                            <td class="text-nowrap">@item.FacilityName</td>
                            <td class="text-center">
                                <span class="badge rounded-pill px-3" style="background-color: rgba(0, 206, 209, 0.1); color: #004d5d; border: 1px solid #00ced1;">
                                    @item.TotalDoses
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">No records found for the selected period.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* --- Pagination --- *@
    @if (totalPages > 1)
    {
        <nav class="mt-3" aria-label="Vaccination summary pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link border-0 shadow-sm mx-1 rounded text-dark"
                       style="background-color: #f8f9fa;"
                       asp-action="VaccinationSummary"
                       asp-route-startDate="@ViewBag.StartDate"
                       asp-route-endDate="@ViewBag.EndDate"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-pageSize="@pageSize">&laquo; Previous</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link border-0 shadow-sm mx-1 rounded @(currentPage == i ? "text-white" : "text-dark")"
                           style="@(currentPage == i ? "background-color:#00ced1;" : "background-color:#f8f9fa;")"
                           asp-action="VaccinationSummary"
                           asp-route-startDate="@ViewBag.StartDate"
                           asp-route-endDate="@ViewBag.EndDate"
                           asp-route-page="@i"
                           asp-route-pageSize="@pageSize">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link border-0 shadow-sm mx-1 rounded text-dark"
                       style="background-color: #f8f9fa;"
                       asp-action="VaccinationSummary"
                       asp-route-startDate="@ViewBag.StartDate"
                       asp-route-endDate="@ViewBag.EndDate"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-pageSize="@pageSize">Next &raquo;</a>
                </li>
            </ul>
        </nav>
    }
</div>

<div class="d-md-none text-center text-muted mt-2">
    <small><i class="bi bi-arrow-left-right"></i> Scroll left/right to see full report</small>
</div>
