@{
    ViewData["Title"] = "Reports Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-4 fw-bold" style="color: #004d5d;">
        <i class="bi bi-bar-chart-line me-2" style="color: #00ced1;"></i>Reports & Analytics
    </h2>
    <hr style="border-top: 2px solid #00ced1;" />

    <div class="row g-4">
        <!-- Vaccination Summary Card -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-3">
                <div class="card-body text-center p-4">
                    <div class="display-5 mb-3" style="color: #00ced1;">
                        <i class="bi bi-clipboard-data"></i>
                    </div>
                    <h5 class="card-title fw-bold" style="color: #004d5d;">Vaccination Summary</h5>
                    <p class="card-text text-muted small">
                        View totals grouped by vaccine and facility for a specific date range.
                    </p>
                    <a asp-action="VaccinationSummary" class="btn text-white w-100"
                       style="background-color: #004d5d; border-radius: 8px;">
                        Open Report
                    </a>
                </div>
            </div>
        </div>

        <!-- Example: Overdue Vaccination Card -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-3">
                <div class="card-body text-center p-4">
                    <div class="display-5 mb-3" style="color: #00ced1;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <h5 class="card-title fw-bold" style="color: #004d5d;">Overdue Vaccinations</h5>
                    <p class="card-text text-muted small">
                        List patients with pending or overdue doses by vaccine type and facility.
                    </p>
                    <a asp-action="OverdueList" class="btn text-white w-100"
                       style="background-color: #004d5d; border-radius: 8px;">
                        Open Report
                    </a>
                </div>
            </div>
        </div>

        <!-- Add more report cards as needed -->
    </div>
</div>
