@model SyntroVaccPApp.DTOs.Administration.AdministrationReadDto

@{
    ViewData["Title"] = "Delete Vaccination Administration";
}

<h2>@ViewData["Title"]</h2>

<h3>Are you sure you want to delete this administration?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">Patient ID</dt>
        <dd class="col-sm-10">@Model.PatientId</dd>

        <dt class="col-sm-2">Vaccine ID</dt>
        <dd class="col-sm-10">@Model.VaccineId</dd>

        <dt class="col-sm-2">Dose Number</dt>
        <dd class="col-sm-10">@Model.DoseNumber</dd>

        <dt class="col-sm-2">Administered On</dt>
        <dd class="col-sm-10">@Model.AdministeredOn.ToShortDateString()</dd>

        <dt class="col-sm-2">Facility ID</dt>
        <dd class="col-sm-10">@Model.FacilityId</dd>

        <dt class="col-sm-2">Administered By</dt>
        <dd class="col-sm-10">@Model.AdministeredBy</dd>

        <dt class="col-sm-2">Batch ID</dt>
        <dd class="col-sm-10">@Model.BatchId</dd>

        <dt class="col-sm-2">Notes</dt>
        <dd class="col-sm-10">@Model.Notes</dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="AdministrationId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
