@model IEnumerable<SyntroVaccPApp.DTOs.Administration.AdministrationReadDto>

@{
    ViewData["Title"] = "Administration Records";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int pageSize = ViewBag.PageSize ?? 5;
}

<div class="container mt-4"> 
    @* --- Header --- *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0" style="color: #004d5d;">
                <i class="bi bi-clipboard-data me-2" style="color: #00ced1;"></i>Administration Records
            </h2>
            <p class="text-muted small mb-0">Manage vaccination administration records</p>
        </div>

        <button type="button" class="btn text-white shadow-sm px-4"
                style="background-color: #004d5d; border-radius: 8px;"
                onclick="openPatientSearchModal()">
            <i class="bi bi-plus-circle me-1"></i> Add Administration
        </button>
    </div>

    @* --- Page Size Selector --- *@
    <div class="d-flex justify-content-end mb-3">
        <div class="btn-group btn-group-sm shadow-sm">
            <span class="btn btn-light disabled border small">Show:</span>
            @foreach (var size in new[] { 5, 10, 20 })
            {
                <a asp-action="Index" asp-route-page="1" asp-route-pageSize="@size"
                   class="btn @(pageSize == size ? "text-white" : "btn-outline-secondary")"
                   style="@(pageSize == size ? "background-color:#004d5d;" : null)">
                    @size
                </a>
            }
        </div>
    </div>

    @* --- Table --- *@
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="min-width: 900px;">
                <thead style="background-color: #004d5d; color: white;">
                    <tr class="text-nowrap">
                        <th>#</th>
                        <th>Patient</th>
                        <th>Vaccine</th>
                        <th>Batch #</th>
                        <th>Dose</th>
                        <th>Date Administered</th>
                        <th>Clinician</th>
                        <th>Facility</th>
                        <th>Notes</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    @if (Model != null && Model.Any())
                    {
                        int rowNumber = (currentPage - 1) * pageSize + 1;
                        foreach (var admin in Model)
                        {
                            <tr id="row-@admin.AdministrationId">
                                <td>@rowNumber</td>
                                <td>@admin.PatientName</td>
                                <td>@admin.VaccineName</td>
                                <td>@admin.BatchNumber</td>
                                <td>@admin.DoseNumber</td>
                                <td>@admin.AdministeredOn.ToShortDateString()</td>
                                <td>@admin.ClinicianName</td>
                                <td>@admin.FacilityName</td>
                                <td>@admin.Notes</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-warning"
                                            onclick="openEditAdministrationModal(@admin.AdministrationId)">
                                        <i class="bi bi-pencil-fill"></i> Edit
                                    </button>

                                </td>
                            </tr>
                            rowNumber++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted">No administration records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* --- Pagination --- *@
    @if (totalPages > 1)
    {
        <nav class="mt-3" aria-label="Administration pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link border-0 shadow-sm mx-1 rounded text-dark"
                       asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize">
                        &laquo; Previous
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link border-0 shadow-sm mx-1 rounded @(currentPage == i ? "text-white" : "text-dark")"
                           style="@(currentPage == i ? "background-color:#00ced1;" : "")"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-pageSize="@pageSize">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link border-0 shadow-sm mx-1 rounded text-dark"
                       asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize">
                        Next &raquo;
                    </a>
                </li>
            </ul>
        </nav>
    }

</div>

<!-- Administration Modal -->
<div class="modal fade" id="createAdministrationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header text-white" style="background-color: #004d5d;">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-plus-circle me-2" style="color: #00ced1;"></i> Add Administration
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="createAdministrationModalBody">
                <!-- AJAX content loads here -->
            </div>
        </div>
    </div>
</div>

<!-- Edit Administration Modal -->
<div class="modal fade" id="editAdministrationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header text-white" style="background-color: #004d5d;">
                <h5 class="modal-title fw-bold"><i class="bi bi-search me-2"></i>Edit Administration Record</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <!-- AJAX will load the full header + body here -->
            <div id="editAdministrationModalBody">
                <!-- AJAX loads _EditAdministrationPartial here -->
            </div>
        </div>
    </div>
</div>


<!-- Patient Search Modal -->
<div class="modal fade" id="searchPatientModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header text-white" style="background-color: #004d5d;">
                <h5 class="modal-title fw-bold"><i class="bi bi-search me-2"></i> Search Patient</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <input type="text" id="patientSearchInput" class="form-control mb-3" placeholder="Type first letters of name..." autofocus />
                <div id="patientSearchResults">
                    <!-- AJAX loads _PatientSearchResults partial here -->
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script> 
    // ============================================
    // OPEN PATIENT SEARCH MODAL
    // ============================================
    function openPatientSearchModal() {

        const modal = new bootstrap.Modal(
            document.getElementById('searchPatientModal')
        );

        modal.show();

        // Load initial patient list (empty search = show all)
        loadPatients('');
    }

           // ============================================
        // OPEN EDIT ADMINISTRATION MODAL
        // ============================================
        function openEditAdministrationModal(adminId) {
            const modalEl = document.getElementById('editAdministrationModal');

            // Show spinner while loading
            $('#editAdministrationModalBody').html(
                '<div class="text-center p-5">' +
                    '<div class="spinner-border text-info"></div>' +
                    '<p class="mt-2 text-muted">Loading form...</p>' +
                '</div>'
            );

            const modal = new bootstrap.Modal(modalEl);
            modal.show();

            $.ajax({
                url: '/Administration/Edit',
                type: 'GET',
                data: { id: adminId },
                success: function (html) {
                    $('#editAdministrationModalBody').html(html);
                },
                error: function (xhr) {
                    $('#editAdministrationModalBody').html(
                        '<div class="alert alert-danger">Error loading form: ' + xhr.status + ' ' + xhr.statusText + '</div>'
                    );
                }
            });
        }


  
    // ============================================
    // LIVE SEARCH (Auto Search While Typing)
    // ============================================
    $(document).on('input', '#patientSearchInput', function () {
        let term = $(this).val();
        loadPatients(term);
    });


    // ============================================
    // LOAD PATIENTS FUNCTION
    // ============================================
    function loadPatients(term) {

        $('#patientSearchResults').html(
            '<div class="text-center p-4">' +
                '<div class="spinner-border text-info"></div>' +
            '</div>'
        );

        $.get('/Administration/SearchPatients',
            { term: term },
            function (html) {
                $('#patientSearchResults').html(html);
            }
        );
    }


    // ============================================
    // SELECT PATIENT → OPEN CREATE ADMINISTRATION
    // ============================================
    function selectPatient(id) {

        // Close search modal
        const searchModalEl = document.getElementById('searchPatientModal');
        const searchModal = bootstrap.Modal.getInstance(searchModalEl);
        searchModal.hide();

        // Prepare create modal
        const adminModalEl = document.getElementById('createAdministrationModal');
        const adminModal = new bootstrap.Modal(adminModalEl);

        $('#createAdministrationModalBody').html(
            '<div class="text-center p-5">' +
                '<div class="spinner-border text-info"></div>' +
                '<p class="mt-2 text-muted">Loading form...</p>' +
            '</div>'
        );

        adminModal.show();

        // Load Create Partial
        $.get('/Administration/Create',
            { patientId: id },
            function (html) {
                $('#createAdministrationModalBody').html(html);
            }
        );
    }


    // ============================================
    // CREATE ADMINISTRATION (AJAX)
    // ============================================
     $(document).on("submit", "#createAdministrationForm", function (e) {
            e.preventDefault();

            var form = $(this);

            $.ajax({
                url: '@Url.Action("Create", "Administration")',
                type: 'POST',
                data: form.serialize(),
                success: function (response) {

                    // If JSON success
                    if (response.success) {
                        $('#createAdministrationModal').modal('hide');

                        // Refresh only administration table
                             location.reload();
                    }
                    else {
                        // Validation errors returned as partial
                        $('#createAdministrationModalBody').html(response);
                    }
                },
                error: function () {
                    alert("Something went wrong.");
                }
            });
        });


           // ============================================
        // EDIT ADMINISTRATION (AJAX + FULL REFRESH)
        // ============================================
        $(document).on('submit', '#editAdministrationForm', function (e) {
            e.preventDefault();

            var form = $(this);
            var button = $('#btnUpdateAdministration');

            button.prop('disabled', true)
                  .html('<span class="spinner-border spinner-border-sm me-1"></span> Updating');

            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                success: function (response) {

                    if (response.success === true) {

                        // Close modal (Bootstrap 5)
                        const modalEl = document.getElementById('editAdministrationModal');
                        const modal = bootstrap.Modal.getInstance(modalEl);
                        modal.hide();

                        // 🔥 FULL PAGE REFRESH
                        location.reload();
                    }
                    else {
                        // Validation errors
                        $('#editAdministrationModalBody').html(response);
                    }
                },
                error: function (xhr) {
                    alert("Error: " + xhr.responseText);
                },
                complete: function () {
                    button.prop('disabled', false)
                          .html('Update');
                }
            });
        });


    </script>
}

