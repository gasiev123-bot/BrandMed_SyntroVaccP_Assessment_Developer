@model IEnumerable<SyntroVaccPApp.Models.AuditLog>

@{
    ViewData["Title"] = "Security Audit Log";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int pageSize = ViewBag.PageSize;
}

<div class="container mt-4">
    @* --- Header Section --- *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 style="color: #004d5d;" class="fw-bold mb-0">
                <i class="bi bi-shield-lock-fill me-2" style="color: #00ced1;"></i>Security Audit Log
            </h2>
            <p class="text-muted small mb-0">Track system changes and data modifications</p>
        </div>

        <button type="button" class="btn btn-sm border-secondary px-3 text-secondary shadow-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Export Log
        </button>
    </div>
 
    @* --- Page Size Selector (Fixed CSS Warnings) --- *@
    <div class="d-flex justify-content-end mb-3">
        <div class="btn-group btn-group-sm shadow-sm" role="group">
            <span class="btn btn-light disabled border small">Show:</span>

            <a asp-action="Index" asp-route-pageSize="5" asp-route-page="1"
               class="btn @(pageSize == 5 ? "text-white" : "btn-outline-secondary")"
               style="@(pageSize == 5 ? "background-color: #004d5d;" : null)">5</a>

            <a asp-action="Index" asp-route-pageSize="20" asp-route-page="1"
               class="btn @(pageSize == 20 ? "text-white" : "btn-outline-secondary")"
               style="@(pageSize == 20 ? "background-color: #004d5d;" : null)">20</a>
        </div>
    </div>


    @* --- Table Card --- *@
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="min-width: 900px;">
                <thead style="background-color: #004d5d; color: white;">
                    <tr class="text-nowrap">
                        <th class="ps-4">Entity</th>
                        <th>Action</th>
                        <th>Changed By</th>
                        <th>Date & Time</th>
                        <th class="pe-4">Change Summary</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="fw-bold" style="color: #004d5d;">@log.EntityName</span>
                            </td>
                            <td>
                                @if (log.Action == "Create")
                                {
                                    <span class="badge rounded-1 px-2 py-1 fw-bold"
                                          style="background-color: #e0f2f1; color: #004d40; border: 1px solid #b2dfdb;">CREATE</span>
                                }
                                else if (log.Action == "Delete")
                                {
                                    <span class="badge rounded-1 px-2 py-1 fw-bold"
                                          style="background-color: #ffebee; color: #b71c1c; border: 1px solid #ffcdd2;">DELETE</span>
                                }
                                else
                                {
                                    <span class="badge rounded-1 px-2 py-1 fw-bold"
                                          style="background-color: #f3f4f6; color: #374151; border: 1px solid #d1d5db;">UPDATE</span>
                                }
                            </td>
                            <td class="text-nowrap">
                                <span class="small fw-medium" style="color: #004d5d;">
                                    <i class="bi bi-person-circle me-1" style="color: #00ced1;"></i> @log.ChangedBy
                                </span>
                            </td>
                            <td class="text-nowrap text-muted small">
                                @log.ActionDate.ToString("dd MMM yyyy HH:mm")
                            </td>
                            <td class="pe-4 py-3">
                                <div class="p-2 rounded small text-dark" style="background-color: #f9fafb; border-left: 3px solid #00ced1; max-width: 400px; line-height: 1.4;">
                                    @log.ChangeSummary
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* --- Pagination Controls --- *@
    @if (totalPages > 1)
    {
        <nav aria-label="Audit log page navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link border-0 shadow-sm mx-1 rounded text-dark"
                       asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize">
                        <span aria-hidden="true">&laquo;</span> Previous
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link border-0 shadow-sm mx-1 rounded @(currentPage == i ? "text-white" : "text-dark")"
                           style="@(currentPage == i ? "background-color: #00ced1;" : "")"
                           asp-action="Index" asp-route-page="@i" asp-route-pageSize="@pageSize">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link border-0 shadow-sm mx-1 rounded text-dark"
                       asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize">
                        Next <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
